[{"start": 0.0, "end": 4.7, "text": " Could the Dallas Cowboys hold a 6-point lead for 74 seconds against 50 grandmas?", "words": [[0.0, 0.14, " Could"], [0.14, 0.28, " the"], [0.28, 0.6, " Dallas"], [0.6, 0.94, " Cowboys"], [0.94, 1.24, " hold"], [1.24, 1.36, " a"], [1.36, 1.72, " 6"], [1.72, 1.92, "-point"], [1.92, 2.16, " lead"], [2.16, 2.36, " for"], [2.36, 3.02, " 74"], [3.02, 3.46, " seconds"], [3.46, 3.7, " against"], [3.7, 4.22, " 50"], [4.22, 4.7, " grandmas?"]]}, {"start": 5.0, "end": 6.92, "text": " The grandmas have an average age of 81.", "words": [[5.0, 5.14, " The"], [5.14, 5.52, " grandmas"], [5.52, 5.68, " have"], [5.68, 5.78, " an"], [5.78, 6.14, " average"], [6.14, 6.4, " age"], [6.4, 6.54, " of"], [6.54, 6.92, " 81."]]}, {"start": 7.38, "end": 9.18, "text": " Their fastest player uses a walker.", "words": [[7.38, 7.5, " Their"], [7.5, 7.94, " fastest"], [7.94, 8.24, " player"], [8.24, 8.58, " uses"], [8.58, 8.76, " a"], [8.76, 9.18, " walker."]]}, {"start": 9.54, "end": 11.36, "text": " Dallas has 53 pro athletes.", "words": [[9.54, 9.74, " Dallas"], [9.74, 9.94, " has"], [9.94, 10.62, " 53"], [10.62, 10.94, " pro"], [10.94, 11.36, " athletes."]]}, {"start": 11.82, "end": 12.56, "text": " 74 seconds.", "words": [[11.82, 12.2, " 74"], [12.2, 12.56, " seconds."]]}, {"start": 12.98, "end": 13.16, "text": " Easy.", "words": [[12.98, 13.16, " Easy."]]}, {"start": 13.66, "end": 14.88, "text": " Except it's Dallas.", "words": [[13.66, 14.0, " Except"], [14.0, 14.56, " it's"], [14.56, 14.88, " Dallas."]]}, {"start": 15.36, "end": 19.1, "text": " Last Sunday, Dallas led Arizona by 14 with 14 minutes left.", "words": [[15.36, 15.54, " Last"], [15.54, 15.86, " Sunday,"], [16.02, 16.34, " Dallas"], [16.34, 16.58, " led"], [16.58, 16.96, " Arizona"], [16.96, 17.2, " by"], [17.2, 17.8, " 14"], [17.8, 18.04, " with"], [18.04, 18.56, " 14"], [18.56, 18.76, " minutes"], [18.76, 19.1, " left."]]}, {"start": 19.42, "end": 22.08, "text": " They still led by 6 with 7