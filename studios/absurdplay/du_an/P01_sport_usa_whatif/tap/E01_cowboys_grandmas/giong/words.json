[{"start": 0.0, "end": 4.7, "text": " Could the Dallas Cowboys hold a 6-point lead for 74 seconds against 50 grandmas?", "words": [[0.0, " Could"], [0.14, " the"], [0.28, " Dallas"], [0.6, " Cowboys"], [0.94, " hold"], [1.24, " a"], [1.36, " 6"], [1.72, "-point"], [1.92, " lead"], [2.16, " for"], [2.36, " 74"], [3.02, " seconds"], [3.46, " against"], [3.7, " 50"], [4.22, " grandmas?"]]}, {"start": 5.0, "end": 6.92, "text": " The grandmas have an average age of 81.", "words": [[5.0, " The"], [5.14, " grandmas"], [5.52, " have"], [5.68, " an"], [5.78, " average"], [6.14, " age"], [6.4, " of"], [6.54, " 81."]]}, {"start": 7.38, "end": 9.18, "text": " Their fastest player uses a walker.", "words": [[7.38, " Their"], [7.5, " fastest"], [7.94, " player"], [8.24, " uses"], [8.58, " a"], [8.76, " walker."]]}, {"start": 9.54, "end": 11.36, "text": " Dallas has 53 pro athletes.", "words": [[9.54, " Dallas"], [9.74, " has"], [9.94, " 53"], [10.62, " pro"], [10.94, " athletes."]]}, {"start": 11.82, "end": 12.56, "text": " 74 seconds.", "words": [[11.82, " 74"], [12.2, " seconds."]]}, {"start": 12.98, "end": 13.16, "text": " Easy.", "words": [[12.98, " Easy."]]}, {"start": 13.66, "end": 14.88, "text": " Except it's Dallas.", "words": [[13.66, " Except,"], [14.0, " it's"], [14.56, " Dallas."]]}, {"start": 15.36, "end": 19.1, "text": " Last Sunday, Dallas led Arizona by 14 with 14 minutes left.", "words": [[15.36, " Last"], [15.54, " Sunday,"], [16.02, " Dallas"], [16.34, " led"], [16.58, " Arizona"], [16.96, " by"], [17.2, " 14"], [17.8, " with"], [18.04, " 14"], [18.56, " minutes"], [18.76, " left."]]}, {"start": 19.42, "end": 22.08, "text": " They still led by 6 with 74 seconds to go.", "words": [[19.42, " They"], [19.54, " still"], [19.86, " led"], [20.04, " by"], [20.22, " 6"], [20.54, " with"], [20.78, " 74"], [21.36, " seconds"], [21.64, " to"], [21.86, " go."]]}, {"start": 22.4, "end": 25.64, "text": " Arizona scored with 10 seconds left, then missed the extra point.", "words": [[22.4, " Arizona"], [22.7, " scored"], [23.06, " with"], [23.26, " 10"], [23.56, " seconds"], [23.86, " left,"], [24.36, " then"], [24.64, " missed"], [24.96, " the"], [25.14, " extra"], [25.38, " point."]]}, {"start": 26.18, "end": 26.84, "text": " Dallas was saved.", "words": [[26.18, " Dallas"], [26.28, " was"], [26.48, " saved."]]}, {"start": 27.14, "end": 28.38, "text": " And lost in overtime anyway.", "words": [[27.14, " And"], [27.38, " lost"], [27.58, " in"], [27.78, " overtime"], [28.1, " anyway."]]}, {"start": 28.9, "end": 30.02, "text": " So grandma's ball.", "words": [[28.7, " So"], [29.02, " grandmas"], [29.76, " ball."]]}, {"start": 30.52, "end": 32.16, "text": " Grandma Ruth hands off to grandma June.", "words": [[30.52, " Grandma"], [30.7, " Ruth"], [30.88, " hands"], [31.18, " off"], [31.4, " to"], [31.56, " grandma"], [31.82, " June."]]}, {"start": 32.64, "end": 33.84, "text": " Dallas misses 6 tackles.", "words": [[32.64, " Dallas"], [32.8, " misses"], [33.06, " 6"], [33.42, " tackles."]]}, {"start": 34.22, "end": 34.64, "text": " Touchdown.", "words": [[34.22, " Touchdown."]]}, {"start": 34.98, "end": 36.9, "text": " The extra point bounces off a hip replacement.", "words": [[34.98, " The"], [35.04, " extra"], [35.28, " point"], [35.58, " bounces"], [35.98, " off"], [36.18, " a"], [36.3, " hip"], [36.46, " replacement."]]}, {"start": 37.34, "end": 37.76, "text": " Overtime.", "words": [[37.34, " Overtime."]]}, {"start": 38.16, "end": 38.5, "text": " Field goal.", "words": [[38.16, " Field"], [38.26, " goal."]]}, {"start": 38.98, "end": 40.62, "text": " Grandmas win 33-30.", "words": [[38.98, " Grandmas"], [39.24, " win"], [39.5, " 33"], [40.08, "-30."]]}, {"start": 41.06, "end": 42.58, "text": " Dallas falls to 3-5.", "words": [[41.06, " Dallas"], [41.3, " falls"], [41.6, " to"], [41.84, " 3"], [42.18, "-5."]]}]