# Niche: how-you-invented — TikTok "How you invented X" (project P02, kit mailcontentnba76-cell/absurdplay-kit branch du-an-moi + overlay studios/p02-invention)
CHANNEL_NAME="How you invented"
LANGUAGE=en
TONE=bua                     # owner 06/11: crude like the viral videos — ass/shit in the hook, max 1 "fucking", double-entendre ending
VOICE_ROUTE=sonicvoice       # sonicvoice | elevenlabs | owner_mp3  (see muse/custom-skills/invention-chain/SKILL.md)
VOICE_NAME="Odd Tilt"        # the kit's voice (Magnific clone 197595, ElevenLabs turbo v2.5 behind it); re-clone on SonicVoice/ElevenLabs from am_thanh/giong_goc_E05.mp3
VOICE_ID=                    # filled by Muse after looking up the clone by name
SONIC_PROVIDER=mini          # SonicVoice provider for clones
SONIC_SPEED=1.0
VOICE_MODEL=eleven_turbo_v2_5   # when VOICE_ROUTE=elevenlabs
TARGET_WPM=218               # after silenceremove (pauses -> 0.12 s) + atempo; viral videos 220-224
LENGTH_S=33-36               # viral 30-43, median 35.8
WIDTH=1080
HEIGHT=1920
LUFS=-14                     # master; TikTok re-downloads of the viral videos measure about -12.4
MUSIC_ROUTE=kit              # kit = tai_nguyen/nhac/the_curious_ukulele_conundrum.mp3 from the owner's audio pack (-19 dB under the voice)
NUCLEAR_GAG=allowed_once     # cooling-tower gag: allowed_once (2/5 viral videos have it) | never  — owner to confirm
CUT_STYLE=cat                # cat = hard cut on every so-you/But/Except/Now (door, toilet paper) | lien = continuous camera (fan, trampoline)
