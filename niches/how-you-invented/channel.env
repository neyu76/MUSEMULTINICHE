# Niche: how-you-invented — TikTok "How you invented X" (project P02, kit mailcontentnba76-cell/absurdplay-kit branch du-an-moi + overlay studios/p02-invention)
CHANNEL_NAME="How you invented"
LANGUAGE=en
TONE=bua                     # owner 06/11: crude like the viral videos — ass/shit in the hook, max 1 "fucking", double-entendre ending
VOICE_ROUTE=elevenlabs       # owner 09/11: ElevenLabs voice below, with emotion tags | sonicvoice | owner_mp3
VOICE_NAME="Jack John"       # ElevenLabs library voice (male, American, ~30s) chosen by the owner 09/11 — replaces the kit's Magnific "Odd Tilt"
VOICE_ID=7EzWGsX10sAS4c9m9cPf
SONIC_PROVIDER=mini          # SonicVoice provider for clones
SONIC_SPEED=1.0
VOICE_MODEL=eleven_v4        # audio tags ([excited], [sarcastic], [laughs]…) only work on eleven_v4 / eleven_v3; turbo v2.5 READS tags aloud
VOICE_TAGS=on                # owner 09/11: use emotion tags (kit SKILL §4 said turbo + no tags — superseded); tags go in loi_tts.txt only
TARGET_WPM=218               # after silenceremove (pauses -> 0.12 s) + atempo; viral videos 220-224
LENGTH_S=33-42               # viral samples 30-43 (median 35.8); kit E06-E08 41.6-41.8
WIDTH=1080
HEIGHT=1920
LUFS=-14                     # master; TikTok re-downloads of the viral videos measure about -12.4
MUSIC_ROUTE=kit              # kit = tai_nguyen/nhac/the_curious_ukulele_conundrum.mp3 from the owner's audio pack (-19 dB under the voice)
NUCLEAR_GAG=never            # kit: cooling towers are the reference channel's signature — do not use
CUT_STYLE=cat                # cat = hard cut on every so-you/But/Except/Now (door, toilet paper) | lien = continuous camera (fan, trampoline)
PRAISE_WORDS="Bullseye.|Gotcha.|Big brain.|Nailed it."   # kit §1d: the channel's OWN praise lines (never the reference channel's Clever!/Genius!/Much better!)
