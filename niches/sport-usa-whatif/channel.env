# Niche: sport-usa-whatif — TikTok channel AbsurdPlay, project P01 "Sport USA" (engine: studios/absurdplay, three.js 3D)
CHANNEL_NAME="AbsurdPlay"
LANGUAGE=en
VOICE_ROUTE=owner_mp3        # owner_mp3 | elevenlabs | magnific_browser  (see muse/custom-skills/absurdplay/SKILL.md)
VOICE_NAME="Sport USA"       # clone in the owner's Magnific account (ElevenLabs v4 behind it); tag [energetic, fast-paced narrator]
VOICE_ID=                    # ElevenLabs voice id, only when VOICE_ROUTE=elevenlabs
TARGET_WPM=158-164           # kit v0.6; atempo / doi_nhip.py to land here
LENGTH_S=60-72
WIDTH=720                    # render size on a CPU worker; hau_ky.py upscales to 1080x1920
HEIGHT=1280
MUSIC_ROUTE=cc0_library      # cc0_library (kit default: alvana-audio CC0, one different track per episode) | elevenlabs | owner_mp3 (e.g. Suno)
MUSIC_PROMPT="Instrumental only, 100-110 BPM, steady kick and bass, hype sports comedy groove, hip-hop/funk, no vocals, loops cleanly"
# Owner will set VOICE_ROUTE and MUSIC_ROUTE later on the Muse account; until then: voice = owner_mp3, music = cc0_library.
