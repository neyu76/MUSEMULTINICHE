# One channel = one identity. Copy this folder: cp -r niches/_template niches/<name> and edit.
# Read by tools/ep/new_episode.sh (and by you/the worker when generating media). No secrets here — API keys stay in ~/.secrets/.
CHANNEL_NAME="RickClips"          # display name
NAME_SUFFIX=RickClips             # deliverable names: Title_Words_<NAME_SUFFIX>.mp4
LANGUAGE=en
VOICE_ID=J8XNjWRT3iUYhRklysg1     # ElevenLabs voice (user's cloned "rick"); each channel should have its OWN voice
VOICE_MODEL=eleven_v4
TEMPO=1.24                        # atempo so the take lands at 212–224 wpm ("rick" reads ~175 wpm raw)
MUSIC_PROMPT="Instrumental only, ~60 s, light sly playful underscore, pizzicato strings, clarinet, bassoon, glockenspiel, 96 BPM, D minor, even loudness, no drums, no vocals"
MUSIC_INSTRUMENTAL=true           # sent as force_instrumental (tools/ep/el_media.py)
MUSIC_MODEL=                      # empty = ElevenLabs default music model
WIDTH=720                         # 720x1280 renders ~2.5x faster on a 4-core/8 GB worker and passes QA; 1080x1920 needs ≥16 GB RAM
HEIGHT=1280
WORKERS=1                         # render workers on this channel's worker VM (4 cores/8 GB: 1)
